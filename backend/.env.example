# Backend environment variables (copy to backend/.env)
# Render: set these in the service's Environment tab (DATABASE_URL + JWT_SECRET_KEY).

# --- Database (REQUIRED) ---
# PostGIS is OPTIONAL: a plain Render Postgres works for core features
# (auth, employees, reports, incentives). Use Supabase if you want full
# geofencing / live-map (PostGIS). Examples:
#   Render Postgres:  postgresql://user:pass@host:5432/dbname
#   Supabase:        postgresql://postgres:<PASSWORD>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yarmouk_water

# --- Security (REQUIRED) ---
# Generate a long random string, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production

DEBUG=false

# --- Optional (only needed if you enable these features later) ---
# REDIS_URL=redis://localhost:6379/0
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET_NAME=yarmouk-water
# S3_REGION=us-east-1
