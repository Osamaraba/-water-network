# Application
APP_NAME=Yarmouk Water Platform
APP_VERSION=1.0.0
DEBUG=false

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yarmouk_water
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (CHANGE IN PRODUCTION!)
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30
RATE_LIMIT_PER_MINUTE=60

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=yarmouk-water
S3_REGION=us-east-1

# GPS Settings
GPS_ACCURACY_THRESHOLD=15.0
GPS_FRESHNESS_THRESHOLD=15
GPS_DISTANCE_FILTER=50.0
GPS_TIME_INTERVAL=30

# Geofence
GEOFENCE_DEFAULT_RADIUS=50.0
METER_READING_RADIUS=15.0

# Offline
OFFLINE_TIMEOUT_MINUTES=30
IDLE_THRESHOLD_MINUTES=10

# Company
COMPANY_NAME=شركة مياه اليرموك
